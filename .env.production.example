APP_NAME=AaoChaleTaxi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aaochaletaxi.com
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Create the database + user in hPanel → Databases → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# sendmail works on Hostinger out of the box. For SMTP: MAIL_MAILER=smtp, smtp.hostinger.com:465 (smtps) with an hPanel mailbox
MAIL_MAILER=sendmail
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@aaochaletaxi.com"
MAIL_FROM_NAME="${APP_NAME}"

SUPPORT_EMAIL=support@aaochaletaxi.com
SUPPORT_PHONE=
COMPANY_LEGAL_NAME=AaoChaleTaxi

# First super admin (created once by PlatformSeeder if none exists)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
